#. Type: select
#. Choices
#. :sl3:
#: ../console-setup.templates:5001
msgid "# Cyrillic - non-Slavic languages"
msgstr "# ຊີຣິລລິກ - ພາສາທີ່ບໍ່ແມ່ນສະລາບ"

#. Type: select
#. Choices
#. :sl3:
#: ../console-setup.templates:5001
msgid ". Cyrillic - non-Slavic languages (for blind users)"
msgstr ". ຊີຣິລລິກ - ພາສາທີ່ບໍ່ແມ່ນສະລາບ (ສຳລັບຜູ້ໃຊ້ງານທີ່ຕາບອດ)"

#. Type: select
#. Choices
#. :sl3:
#: ../console-setup.templates:5001
